# ===== VSN backend configuration =====

# Server
PORT=4000
# Public base URL used to build absolute audio URLs (in production set to https://your-backend.onrender.com)
PUBLIC_BASE_URL=http://localhost:4000
# Comma separated list of allowed origins, or * for any
CORS_ORIGIN=*

# Demo mode: lets the API run without Firebase/HF so you can test the full flow.
# Set to 0 in production.
DEMO_MODE=1

# Hugging Face Inference API (free tier). Kept server-side ONLY.
HF_API_TOKEN=
# Model used for instrumental / full-song generation
HF_MODEL_MUSIC=facebook/musicgen-small
# Optional vocal/TTS model (e.g. suno/bark-small). If empty, generation falls
# back to the music model with vocals described in the prompt.
HF_MODEL_VOCAL=

# Daily generation cap per user (enforced server-side)
DAILY_LIMIT=10

# Comma separated UIDs allowed to access /api/admin (moderation dashboard).
# In demo mode the uid "admin" (token: demo-admin) is an admin automatically.
ADMIN_UIDS=

# ---- Firebase Admin (needed for real auth, Firestore, Storage) ----
# Either paste the whole service account JSON, OR use the individual fields below.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
